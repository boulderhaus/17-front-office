    "provider_call_id": "{{call_control_id}}"
   },
   "messages": [
    {
     "type": "request_start",
     "content": "Okay, putting that in."
    }
   ]
  }
 },
 {
  "type": "webhook",
  "timeout_ms": 5000,
  "webhook": {
   "name": "request_human",
   "description": "Queue an owner alert only for a caller's explicit request for a person or a deterministic emergency already confirmed by triage_call. Audio or volume comments are not escalation requests.",
   "url": "https://front-office.example/tools/request-human",
   "method": "POST",
   "body_parameters": {
    "type": "object",
    "properties": {
     "reason": {
      "type": "string",
      "enum": [
       "explicit_request",
       "emergency"
      ],
      "description": "Why escalation is authorized."
     },
     "caller_quote": {
      "type": "string",
      "description": "The caller's exact words explicitly requesting a person or describing the confirmed emergency."
     },
     "caller_name": {
      "type": "string",
      "description": "Caller's name, when known."
     },
     "problem_description": {
      "type": "string",
      "description": "The service problem, when known."
     }
    },
    "required": [
     "reason",
     "caller_quote"
    ]
   },
   "preset_body_fields": {
    "provider_call_id": "{{call_control_id}}",
    "from_number": "{{telnyx_end_user_target}}"
   },
   "store_fields_as_variables": [
    {
     "name": "owner_transfer_targets",
     "value_path": "transferTargets"
    }
   ]
  }
 },
 {
  "type": "webhook",
  "timeout_ms": 5000,
  "webhook": {
   "name": "mark_spam_call",
   "description": "Mark a clear non-service call (vendor or seller, solicitor, recruiter, robocall or scripted pitch, wrong number) as spam so it never counts. Never for a possible customer, an emergency, or an existing customer. Only status=marked allows hanging up; status=continue means keep helping the caller.",
   "url": "https://front-office.example/tools/mark-spam",
   "method": "POST",
   "body_parameters": {
    "type": "object",
    "properties": {
     "category": {
      "type": "string",
      "enum": [
       "vendor",
       "solicitor",
       "sales",
       "recruiter",
       "robocall",
       "wrong_number"
      ],
      "description": "Why this is not a service call."
     },
     "caller_quote": {
      "type": "string",
      "description": "The caller's exact words that show this is not a service call."
     }
    },
    "required": [
     "category",
     "caller_quote"
    ]
   },
   "preset_body_fields": {
    "provider_call_id": "{{call_control_id}}",
    "from_number": "{{telnyx_end_user_target}}"
   }
  }
 },
 {
  "type": "transfer",
  "transfer": {
   "from": "{{telnyx_agent_target}}",
   "targets": "{{owner_transfer_targets}}",
   "description": "Connect only to the approved owner, after request_human authorizes it and the caller agrees. Never for audio complaints.",
   "warm_transfer_instructions": "You are the owner's AI assistant. Briefly tell the owner who is calling, the problem, and whether it is urgent, using only captured facts. Keep the handoff under 15 seconds. Never say the job is booked unless verified.",
   "voicemail_detection": {
    "detection_mode": "premium",
    "on_voicemail_detected": {
     "action": "stop_transfer"
    }
   },
   "bridge_beep": {
    "enabled": true,
    "target_legs": "self"
   }
  }
 },
 {
  "type": "hangup",
  "hangup": {
   "description": "Immediately terminate the call after a voicemail callback message, an explicit goodbye, or a completed closing sentence. Invoke this in the same turn as the closing words; never leave silence after saying goodbye."
  }
 }
]"
`;
