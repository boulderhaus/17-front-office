{
  "name": "@rea/ai-front-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "dev": "node --import tsx --watch src/server.ts",
    "migrate": "node --import tsx scripts/migrate.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node --import tsx scripts/run-simulated-call.ts",
    "simulate:launch": "node --import tsx scripts/run-launch-simulations.ts",
    "configure:telnyx": "node --import tsx scripts/configure-telnyx.ts"
  },
  "dependencies": {
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
