NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://front-office.example.com
DEFAULT_TENANT_ID=default
DEFAULT_BUSINESS_NAME=Your Service Business
DEFAULT_TIMEZONE=America/Chicago
DEMO_MODE=false
# Allows signed provider test calls before a first-customer GO. Never use for customer traffic.
PROVIDER_TEST_MODE=false
# Set only after the launch checklist passes with real Telnyx and calendar accounts.
LIVE_PROVIDER_PROOF_AT=

DATABASE_URL=postgresql://front_office:change-me@postgres:5432/front_office
# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Generate each independently: openssl rand -base64 32
ADMIN_TOKEN=
TOOL_TOKEN=
SESSION_SIGNING_KEY=

TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_ASSISTANT_ID=
# Optional billing grace line: shared TeXML voicemail app (npm run configure:voicemail -- --apply prints the id).
# Unset = a lapsed shop's number is disconnected immediately.
TELNYX_VOICEMAIL_APP_ID=
# The voice every assistant gets (src/voice/voice-mode.ts): standard (default) or speech_to_speech.
# speech_to_speech = every shop, the demo line and the setup helper use TELNYX_S2S_MODEL + TELNYX_S2S_VOICE; a shop
# that can't (instructions too long, model or voice unset, or Telnyx refuses its speech-to-speech assistant at go-live
# or on a settings save) keeps the standard voice. Then run npm run configure:telnyx -- --apply.
# Rollback: set TELNYX_VOICE_MODE=standard and run npm run configure:telnyx -- --apply.
TELNYX_VOICE_MODE=standard
# Tenant ids that keep the standard voice in speech_to_speech mode ("platform" = the setup helper).
# Rollback for one shop: add its id and run npm run configure:telnyx -- --apply.
TELNYX_STANDARD_TENANT_IDS=
# Opt-in list while TELNYX_VOICE_MODE=standard: these shops only get speech-to-speech. Empty = every assistant standard.
# Rollback: remove the tenant id and run npm run configure:telnyx -- --apply. Model and voice have no default.
TELNYX_S2S_TENANT_IDS=
TELNYX_S2S_MODEL=
TELNYX_S2S_VOICE=
# Optional: backend text model that runs tools in speech-to-speech mode. Unset = the model the shop already uses.
TELNYX_S2S_BACKEND_MODEL=
# Keep false until the account and applicable US A2P campaign are approved.
TELNYX_MESSAGING_APPROVED=false
# Optional one-time founder welcome after an owner explicitly opts in during signup.
# The sender must be owned, ported, or otherwise approved for messaging in Telnyx.
FOUNDER_WELCOME_ENABLED=false
FOUNDER_WELCOME_FROM_NUMBER=
FOUNDER_WELCOME_NAME=
FOUNDER_WELCOME_TEMPLATE=Welcome to Call Otto. I'm {founder_name}. This is my number if you need anything or have an idea for making this more useful for {business_name}. Reply STOP to opt out.
# Set true only after qualified review for the launch jurisdiction and exact disclosure text.
RECORDING_CONSENT_APPROVED=false
# Provider credentials may remain empty while the service is paused; activation stays NO-GO.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# "Continue with Microsoft" (Entra app; redirect URI = PUBLIC_BASE_URL/auth/microsoft/callback). Leave empty to hide the button.
# Work and school accounts need the optional ID-token claims "email" and "xms_edov" (Token configuration in Entra).
# Without xms_edov every work account is refused and sent to the email link; personal Microsoft accounts still work.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Safe staging default. Add named E.164 destinations before provider-test mode.
OWNER_DESTINATIONS_JSON={}

# Optional HTTPS payment link shown only after a founding-pilot application is submitted.
# Leave empty until the checkout plan and activation terms have been reviewed.
FOUNDING_CHECKOUT_URL=

# Optional self-serve subscription checkout. Configure all three together.
STRIPE_SECRET_KEY=
# Optional: lets the card change open inside Plan and billing. Unset: Stripe's own card page, which returns the owner by itself.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Plans for sale, priced by answered calls: Solo, Team, Fleet (scripts/create-stripe-plans.ts prints these).
# Solo is required (falls back to STRIPE_PRICE_ID); a bigger plan without a price is not sold.
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_TEAM=
# The old $179.99 Team price, so Team subscriptions still on it stay recognized as Team.
STRIPE_PRICE_ID_TEAM_LEGACY=
STRIPE_PRICE_ID_FLEET=
# "Unlimited calls" add-on, one price per plan (+$50 / +$75 / +$125). Fair use: up to 3x the plan's calls.
STRIPE_PRICE_ID_UNLIMITED_SOLO=
STRIPE_PRICE_ID_UNLIMITED_TEAM=
STRIPE_PRICE_ID_UNLIMITED_FLEET=
# Legacy, recognized on existing subscriptions, never sold: Pro (STRIPE_PRICE_ID_PRO, or STRIPE_PRICE_ID_PLUS) and the old Solo price.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_PLUS=
# Limited-time "first month half off": a 50%, duration-once coupon. Ignored while a trial is on; false turns the offer and its copy off.
FIRST_MONTH_OFFER_ENABLED=true
STRIPE_FIRST_MONTH_COUPON_ID=
STRIPE_FIRST_MONTH_PERCENT_OFF=50
# Hard paywall: 0 charges at checkout. Free days before the first charge only if set above 0.
STRIPE_TRIAL_DAYS=0
# Plan names, prices and included answered calls on our pages. Must match the Stripe prices.
PLAN_SOLO_LABEL=Solo
PLAN_SOLO_PRICE_CENTS=4999
PLAN_SOLO_CALLS=60
PLAN_PRO_LABEL=Pro
PLAN_PRO_PRICE_CENTS=9999
PLAN_PRO_CALLS=125
PLAN_TEAM_LABEL=Team
PLAN_TEAM_PRICE_CENTS=14999
PLAN_TEAM_CALLS=250
PLAN_FLEET_LABEL=Fleet
PLAN_FLEET_PRICE_CENTS=34999
PLAN_FLEET_CALLS=500
PLAN_SOLO_UNLIMITED_CENTS=5000
PLAN_TEAM_UNLIMITED_CENTS=7500
PLAN_FLEET_UNLIMITED_CENTS=12500
# Each answered call past the plan, billed on its own invoice after the billing period ends.
OVERAGE_CENTS_PER_CALL=75

# Optional included Sunday week-ahead email delivery.
RESEND_API_KEY=
# hello@callotto.co once the domain is verified in Resend. The name shows as the sender: Call Otto <hello@callotto.co>.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Call Otto
# Brock's follow-up when the AI setup helper can't finish. Sent as "Brock from Call Otto" from FOUNDER_FROM_EMAIL
# (blank: brock@ + the RESEND_FROM_EMAIL domain), replies go to FOUNDER_REPLY_TO (blank: SUPPORT_EMAIL).
FOUNDER_FROM_EMAIL=
FOUNDER_REPLY_TO=
# When owners can book a 10-minute setup call with him, in FOUNDER_TIMEZONE. Connect his calendars with the link
# from `node --import tsx scripts/founder-connect-link.ts`, then pick "Book here" at /admin/founder-calendars.
FOUNDER_BOOKING_WINDOWS=Mon-Fri 10:00-12:00,14:00-17:00
FOUNDER_TIMEZONE=America/New_York

# Optional product analytics + error tracking (PostHog). Unset = nothing loads or sends.
# Public project API key (phc_...). Browser traffic goes through /ingest on this server.
POSTHOG_KEY=
# https://us.i.posthog.com (default) or https://eu.i.posthog.com only.
POSTHOG_HOST=https://us.i.posthog.com
